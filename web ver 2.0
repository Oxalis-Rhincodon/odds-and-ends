<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oxalis-Rhincodon</title>
<link rel="icon" type="image/jpeg" href="favicon.jpeg">
<meta name="description" content="links">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,400..600&family=JetBrains+Mono:wght@400;500&family=Work+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     DESIGN TOKENS — change these to restyle the whole page
     ============================================================ */
  :root{
    --bg-0:#030304;
    --bg-1:#111114;
    --accent-1:#6e7178;       /* primary accent (grey) */
    --accent-1-light:#c4c7cc; /* lighter grey, hover/glow */
    --accent-2:#8a8d93;       /* secondary grey */
    --text:#ececee;
    --text-dim:#a3a6ab;
    --label:#9ea2a8;          /* small caps / eyebrow / tag color */
    --radius:2px;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ min-height:100%; background:var(--bg-1); }

  body{
    background:
      radial-gradient(ellipse 900px 600px at var(--mx,50%) var(--my,20%), rgba(196,199,204,0.07), transparent 60%),
      linear-gradient(180deg, var(--bg-0) 0%, var(--bg-1) 100%);
    background-attachment:fixed;
    color:var(--text);
    font-family:'Work Sans', sans-serif;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:48px 20px;
    overflow-x:hidden;
    position:relative;
  }

  /* ---------- background layers ---------- */
  .stars{ position:fixed; inset:0; pointer-events:none; z-index:0; }
  .star{
    position:absolute; border-radius:50%; background:#d8dade;
    animation:twinkle 4s ease-in-out infinite;
  }
  @keyframes twinkle{ 0%,100%{ opacity:.15; } 50%{ opacity:.8; } }

  /* Roman Space Telescope schematic */
  .diagram{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    pointer-events:none;
    z-index:0;
    opacity:0.4;
  }
  .diagram text{
    font-family:'JetBrains Mono', monospace;
    font-size:10px;
    letter-spacing:0.12em;
    fill:#8a8d93;
    stroke:none;
  }
  /* darkens the middle so the card stays readable */
  .vignette{
    position:fixed; inset:0; pointer-events:none; z-index:0;
    background:radial-gradient(ellipse 480px 560px at 50% 50%, rgba(3,3,4,0.78), transparent 100%);
  }

  .card{
    position:relative;
    z-index:1;
    width:100%;
    max-width:440px;
    text-align:center;
    zoom:1.45;
  }

  .mark{ width:64px; height:64px; margin:0 auto 22px; }
  .mark svg{
    width:100%; height:100%;
    transform-origin:50% 50%;
    animation:reveal 1.4s cubic-bezier(.34,1.56,.64,1) both;
  }
  @keyframes reveal{
    0%{ transform:scale(0.2) rotate(-25deg); opacity:0; }
    60%{ opacity:1; }
    100%{ transform:scale(1) rotate(0deg); opacity:1; }
  }

  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--label);
    opacity:0;
    animation:fade-up 0.7s ease 0.5s both;
  }

  h1{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:clamp(38px, 9vw, 52px);
    letter-spacing:-0.01em;
    margin:6px 0 2px;
    color:var(--text);
    opacity:0;
    animation:fade-up 0.7s ease 0.62s both;
  }

  .clan-tag{
    font-family:'JetBrains Mono', monospace;
    font-size:14px;
    vertical-align:middle;
    color:var(--label);
    border:1px solid var(--label);
    border-radius:3px;
    padding:2px 6px;
    margin-left:8px;
  }

  .subtitle{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:400;
    font-size:15px;
    color:var(--text-dim);
    opacity:0;
    animation:fade-up 0.7s ease 0.74s both;
  }

  .avatar{
    width:104px;
    height:104px;
    border-radius:50%;
    margin:28px auto 18px;
    display:block;
    object-fit:cover;
    border:1px solid rgba(196,199,204,0.35);
    padding:5px;
    opacity:0;
    animation:fade-up 0.7s ease 0.86s both;
  }

  .bio{
    font-size:14.5px;
    line-height:1.6;
    color:var(--text-dim);
    max-width:340px;
    margin:0 auto 34px;
    opacity:0;
    animation:fade-up 0.7s ease 0.98s both;
  }

  @keyframes fade-up{
    from{ opacity:0; transform:translateY(10px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .links{
    display:flex;
    flex-direction:column;
    gap:10px;
    opacity:0;
    animation:fade-up 0.7s ease 1.1s both;
  }

  .link{
    display:flex;
    align-items:center;
    gap:12px;
    padding:14px 18px;
    border:1px solid rgba(236,236,238,0.14);
    border-radius:var(--radius);
    background:rgba(8,8,10,0.55);
    backdrop-filter:blur(3px);
    text-decoration:none;
    color:var(--text);
    text-align:left;
    transition:border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
    cursor:pointer;
  }
  .link:hover, .link:focus-visible{
    border-color:var(--accent-1-light);
    background:rgba(196,199,204,0.08);
    transform:translateX(3px);
    outline:none;
  }
  .link .no{
    font-family:'JetBrains Mono', monospace;
    font-size:10px;
    color:var(--label);
    letter-spacing:0.08em;
    min-width:28px;
  }
  .link .label{
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.04em;
    text-transform:uppercase;
    flex:1;
  }
  .link .arrow{
    font-size:13px;
    color:var(--text-dim);
    opacity:0;
    transition:opacity 0.2s ease, transform 0.2s ease;
  }
  .link:hover .arrow{ opacity:1; transform:translateX(2px); }

  footer{
    margin-top:40px;
    font-family:'JetBrains Mono', monospace;
    font-size:10px;
    letter-spacing:0.1em;
    color:rgba(163,166,171,0.45);
    text-transform:uppercase;
    opacity:0;
    animation:fade-up 0.7s ease 1.22s both;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; }
  }
</style>
</head>
<body>

<div class="stars" id="stars"></div>

<!-- Nancy Grace Roman Space Telescope — simplified schematic, not to scale -->
<svg class="diagram" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" fill="none" stroke="#8a8d93" stroke-width="1" aria-hidden="true">
  <defs>
    <pattern id="cells" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" stroke="#8a8d93" stroke-width="0.6"/>
    </pattern>
  </defs>

  <!-- outer barrel + open aperture cover -->
  <rect x="520" y="200" width="160" height="250"/>
  <path d="M520 200L462 140M680 200L738 140"/>
  <path d="M462 140H520M680 140H738" stroke-dasharray="3 4"/>
  <ellipse cx="600" cy="200" rx="80" ry="14"/>
  <ellipse cx="600" cy="200" rx="40" ry="7"/>
  <path d="M600 200V150M520 200L600 150L680 200"/>
  <circle cx="600" cy="150" r="9"/>

  <!-- instruments -->
  <rect x="535" y="310" width="70" height="60" stroke-dasharray="4 3"/>
  <rect x="617" y="325" width="48" height="45" stroke-dasharray="4 3"/>
  <rect x="535" y="395" width="130" height="30"/>

  <!-- spacecraft bus + lower sun shade -->
  <rect x="500" y="450" width="200" height="85"/>
  <path d="M500 480H700M550 450V535M650 450V535"/>
  <rect x="440" y="548" width="320" height="8"/>

  <!-- solar arrays -->
  <rect x="140" y="470" width="360" height="48" fill="url(#cells)"/>
  <rect x="700" y="470" width="360" height="48" fill="url(#cells)"/>

  <!-- high-gain antenna -->
  <path d="M700 500L792 440"/>
  <ellipse cx="802" cy="432" rx="9" ry="26" transform="rotate(-30 802 432)"/>

  <!-- dimension line for the primary mirror -->
  <path d="M520 98H680M520 90V106M680 90V106"/>

  <!-- callouts -->
  <path d="M600 98V80M738 140L860 100M635 350L860 300M665 410L860 380M300 470L300 400M900 495H1000M440 552L330 600" stroke-dasharray="2 3" stroke-opacity=".7"/>
  <text x="560" y="72">Ø 2.4 M PRIMARY MIRROR</text>
  <text x="866" y="104">APERTURE COVER (DEPLOYED)</text>
  <text x="866" y="304">WIDE FIELD INSTRUMENT</text>
  <text x="866" y="384">CORONAGRAPH</text>
  <text x="230" y="392">SOLAR ARRAY</text>
  <text x="1004" y="499">HIGH-GAIN ANTENNA</text>
  <text x="150" y="620">LOWER INSTRUMENT SUN SHADE</text>
  <text x="440" y="700" style="letter-spacing:.3em">NANCY GRACE ROMAN SPACE TELESCOPE</text>
  <text x="440" y="718">SCHEMATIC / NOT TO SCALE</text>
</svg>

<div class="vignette"></div>

<div class="card">

  <!-- signature mark: black hole with accretion ring -->
  <div class="mark">
    <svg viewBox="0 0 64 64" fill="none">
      <ellipse cx="32" cy="32" rx="28" ry="9" stroke="#8a8d93" stroke-width="2.2" transform="rotate(-18 32 32)"/>
      <ellipse cx="32" cy="32" rx="20" ry="6" stroke="#c4c7cc" stroke-width="1.4" transform="rotate(-18 32 32)" opacity=".8"/>
      <circle cx="32" cy="32" r="10" fill="#000" stroke="#c4c7cc" stroke-width="1"/>
    </svg>
  </div>

  <p class="eyebrow">Sparky Bagguette</p>
  <h1>Oxalis-Rhincodon <span class="clan-tag">Plant</span></h1>
  <p class="subtitle">Fence them in fence them out</p>

  <img class="avatar" src="avatar.jpeg" alt="avatar">

  <p class="bio">I love blackholes 🖤</p>

  <div class="links">

    <a class="link" href="https://github.com/Oxalis-Rhincodon" target="_blank" rel="noopener">
      <span class="no">01</span>
      <span class="label">Github</span>
      <span class="arrow">→</span>
    </a>

    <div class="link" onclick="navigator.clipboard.writeText('._.oxalis'); this.querySelector('.arrow').textContent='copied'; setTimeout(()=>this.querySelector('.arrow').textContent='copy',1200)">
      <span class="no">02</span>
      <span class="label">Discord</span>
      <span class="arrow">copy</span>
    </div>

    <a class="link" href="https://steamcommunity.com/profiles/76561198056167475/" target="_blank" rel="noopener">
      <span class="no">03</span>
      <span class="label">steam</span>
      <span class="arrow">→</span>
    </a>

    <a class="link" href="https://www.roblox.com/users/1866687930/profile" target="_blank" rel="noopener">
      <span class="no">04</span>
      <span class="label">roblox</span>
      <span class="arrow">→</span>
    </a>

  </div>

  <footer>halo &lt;3</footer>

</div>

<script>
  // cursor-follow glow
  document.addEventListener('mousemove', (e)=>{
    const x = (e.clientX / window.innerWidth) * 100;
    const y = (e.clientY / window.innerHeight) * 100;
    document.body.style.setProperty('--mx', x + '%');
    document.body.style.setProperty('--my', y + '%');
  });

  // twinkling starfield
  const field = document.getElementById('stars');
  for (let i = 0; i < 90; i++) {
    const s = document.createElement('div');
    const size = Math.random() * 1.8 + 0.6;
    s.className = 'star';
    s.style.cssText =
      `left:${Math.random()*100}%;top:${Math.random()*100}%;` +
      `width:${size}px;height:${size}px;` +
      `animation-delay:${(Math.random()*4).toFixed(2)}s;` +
      `animation-duration:${(3 + Math.random()*4).toFixed(2)}s;`;
    field.appendChild(s);
  }
</script>

</body>
</html>
